# .env olarak kopyala ve doldur. Bu dosya git'e eklenmez.

# Telegram (önerilen: bildirim + komutlar)
AKIM_TELEGRAM_BOT_TOKEN=
AKIM_TELEGRAM_CHAT_ID=

# Telefona anında push (ntfy uygulaması)
AKIM_NTFY_TOPIC=

# Discord / Slack webhook
AKIM_DISCORD_WEBHOOK_URL=
AKIM_SLACK_WEBHOOK_URL=

# Genel webhook
AKIM_WEBHOOK_URL=

# E-posta (SMTP)
AKIM_SMTP_USER=
AKIM_SMTP_PASSWORD=

# İsteğe bağlı: Claude ile oynanış benzerliği doğrulaması
# AKIM_LLM_ENABLED=true
ANTHROPIC_API_KEY=

# İsteğe bağlı: yerel Laya karar modeli (imajı EXTRAS=llm,laya ile derle)
# AKIM_LAYA_ENABLED=true

# Web paneli: doluysa POST uç noktaları "Authorization: Bearer <token>" ister
AKIM_WEB_TOKEN=
