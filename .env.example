# .env olarak kopyala ve doldur. Bu dosya git'e eklenmez.

# Telegram (önerilen: bildirim + komutlar)
AKIM_TELEGRAM_BOT_TOKEN=
AKIM_TELEGRAM_CHAT_ID=

# Telefona anında push (ntfy uygulaması). Konu adı bir paroladır: tahmin edilemez olsun (en az 12 karakter).
# Arkadaşlarını katmak için: akim invite   (rehber: docs/arkadaslar.md)
AKIM_NTFY_TOPIC=

# Discord / Slack webhook
AKIM_DISCORD_WEBHOOK_URL=
AKIM_SLACK_WEBHOOK_URL=

# Genel webhook
AKIM_WEBHOOK_URL=

# E-posta (SMTP)
AKIM_SMTP_USER=
AKIM_SMTP_PASSWORD=

# İsteğe bağlı: yerel ve ücretsiz Laya karar modeli (Docker imajını EXTRAS=laya ile derle)
# AKIM_LAYA_ENABLED=true

# Web paneli: varsayılan yalnızca bu cihazdan açılır. Telefondan/ağdan açmak için AKIM_WEB_HOST=0.0.0.0 yap
# VE güçlü bir token ayarla (örn. python -c "import secrets; print(secrets.token_urlsafe(24))").
# Token doluysa kontrol uçları "Authorization: Bearer <token>" ister; boşsa kontrol yalnızca bu cihazdan çalışır.
AKIM_WEB_TOKEN=
# AKIM_WEB_HOST=0.0.0.0
